{"type":"before","callId":"call@8","startTime":4811.522,"class":"Page","method":"addInitScript","params":{"source":"(({\n      p1,\n      p2,\n      p3,\n      p4,\n      seedUnifiedPlans\n    }) => {\n      if (seedUnifiedPlans) {\n        const d = new Date();\n        const todayStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;\n        const futureStr = '2099-12-31';\n        const makePlan = (id, title, date, surahNumber, surahName) => ({\n          id,\n          title,\n          createdAt: new Date().toISOString(),\n          isActive: true,\n          isPaused: false,\n          input: {\n            title,\n            startSurah: surahNumber,\n            startAyah: 1,\n            endSurah: surahNumber,\n            endAyah: 5,\n            level: 'intermediate',\n            dailyAvailableMinutes: 20,\n            dailyRevisionMinutes: 10,\n            paceType: 'verses_per_day',\n            paceQuantity: 5,\n            activeDays: [0, 1, 2, 3, 4, 5, 6],\n            restDays: [],\n            startDate: date,\n            schedulePreference: 'single_session'\n          },\n          totalUnits: 5,\n          completedUnits: 0,\n          completionPercentage: 0,\n          totalVersesCount: 5,\n          estimatedEndDate: date,\n          estimatedDurationDays: 1,\n          averageDailyMinutes: 20,\n          weeklyHoursAverage: 2,\n          pacingStatus: 'on_track',\n          schedule: [{\n            id: `${id}-day-1`,\n            dayNumber: 1,\n            date,\n            dayNameAr: 'اليوم',\n            isRestDay: false,\n            status: 'pending',\n            totalEstimatedMinutes: 20,\n            memorizationTask: {\n              id: `${id}-mem-1`,\n              type: 'memorization',\n              surahNumber,\n              surahName,\n              startAyah: 1,\n              endAyah: 5,\n              versesCount: 5,\n              pagesCount: 1,\n              estimatedMinutes: 20,\n              completed: false,\n              description: `حفظ ${surahName} 1-5`\n            }\n          }]\n        });\n        localStorage.setItem('wird_engine_plans', JSON.stringify([makePlan('plan-a', 'خطة جزء عمّ الأولى', todayStr, 78, 'النبأ'), makePlan('plan-b', 'خطة سورة الملك الثانية', todayStr, 67, 'الملك'), makePlan('plan-future', 'خطة مستقبلية مؤجلة', futureStr, 36, 'يس')]));\n      }\n      const originalFetch = window.fetch.bind(window);\n      window.fetch = async (input, init) => {\n        const url = typeof input === 'string' ? input : input instanceof Request ? input.url : '';\n        if (url.endsWith('/mushafs/hafs/kfqc/svg/001.svg')) {\n          return new Response(p1, {\n            status: 200,\n            headers: {\n              'content-type': 'image/svg+xml'\n            }\n          });\n        }\n        if (url.endsWith('/mushafs/hafs/kfqc/svg/002.svg')) {\n          return new Response(p2, {\n            status: 200,\n            headers: {\n              'content-type': 'image/svg+xml'\n            }\n          });\n        }\n        if (url.endsWith('/mushafs/hafs/kfqc/svg/003.svg')) {\n          return new Response(p3, {\n            status: 200,\n            headers: {\n              'content-type': 'image/svg+xml'\n            }\n          });\n        }\n        if (url.endsWith('/mushafs/hafs/kfqc/svg/004.svg')) {\n          return new Response(p4, {\n            status: 200,\n            headers: {\n              'content-type': 'image/svg+xml'\n            }\n          });\n        }\n        if (url.includes('api.quran.com/api/v4/tafsirs/')) {\n          return new Response(JSON.stringify({\n            tafsir: {\n              text: '<p>تفسير ميسر للآية المختارة للتحقق من العرض التفاعلي.</p>',\n              resource_name: 'التفسير الميسر'\n            }\n          }), {\n            status: 200,\n            headers: {\n              'content-type': 'application/json'\n            }\n          });\n        }\n        return originalFetch(input, init);\n      };\n    })({\"p1\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 240 400\\\"><g id=\\\"content\\\"><path d=\\\"M 10 10 L 230 10 L 230 390 L 10 390 Z\\\" fill=\\\"#102d29\\\"/></g><g id=\\\"ayah_markers\\\"><path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-1\\\" ayah=\\\"1\\\" surah=\\\"1\\\" d=\\\"M 20 18 L 200 18 L 200 42 L 20 42 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-2\\\" ayah=\\\"2\\\" surah=\\\"1\\\" d=\\\"M 20 48 L 200 48 L 200 72 L 20 72 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-3\\\" ayah=\\\"3\\\" surah=\\\"1\\\" d=\\\"M 20 78 L 200 78 L 200 102 L 20 102 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-4\\\" ayah=\\\"4\\\" surah=\\\"1\\\" d=\\\"M 20 108 L 200 108 L 200 132 L 20 132 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-5\\\" ayah=\\\"5\\\" surah=\\\"1\\\" d=\\\"M 20 138 L 200 138 L 200 162 L 20 162 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-6\\\" ayah=\\\"6\\\" surah=\\\"1\\\" d=\\\"M 20 168 L 200 168 L 200 192 L 20 192 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-7\\\" ayah=\\\"7\\\" surah=\\\"1\\\" d=\\\"M 20 198 L 200 198 L 200 222 L 20 222 Z\\\"/></g></svg>\",\"p2\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 240 400\\\"><g id=\\\"content\\\"><path d=\\\"M 10 10 L 230 10 L 230 390 L 10 390 Z\\\" fill=\\\"#102d29\\\"/></g><g id=\\\"ayah_markers\\\"><path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-1\\\" ayah=\\\"1\\\" surah=\\\"2\\\" d=\\\"M 20 18 L 200 18 L 200 42 L 20 42 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-2\\\" ayah=\\\"2\\\" surah=\\\"2\\\" d=\\\"M 20 48 L 200 48 L 200 72 L 20 72 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-3\\