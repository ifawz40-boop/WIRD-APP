{"type":"before","callId":"call@8","startTime":69961.931,"class":"Page","method":"addInitScript","params":{"source":"(({\n      p1,\n      p2\n    }) => {\n      const originalFetch = window.fetch.bind(window);\n      window.fetch = async (input, init) => {\n        const url = typeof input === 'string' ? input : input instanceof Request ? input.url : '';\n        if (url.endsWith('/mushafs/hafs/kfqc/svg/001.svg')) {\n          return new Response(p1, {\n            status: 200,\n            headers: {\n              'content-type': 'image/svg+xml'\n            }\n          });\n        }\n        if (url.endsWith('/mushafs/hafs/kfqc/svg/002.svg')) {\n          return new Response(p2, {\n            status: 200,\n            headers: {\n              'content-type': 'image/svg+xml'\n            }\n          });\n        }\n        if (url.includes('api.quran.com/api/v4/tafsirs/')) {\n          return new Response(JSON.stringify({\n            tafsir: {\n              text: '<p>تفسير ميسر للآية المختارة للتحقق من العرض التفاعلي.</p>',\n              resource_name: 'التفسير الميسر'\n            }\n          }), {\n            status: 200,\n            headers: {\n              'content-type': 'application/json'\n            }\n          });\n        }\n        return originalFetch(input, init);\n      };\n    })({\"p1\":\"<svg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 240 400\\\"><g id=\\\"content\\\"><path d=\\\"M 10 10 L 230 10 L 230 390 L 10 390 Z\\\" fill=\\\"#102d29\\\"/></g><g id=\\\"ayah_markers\\\"><path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-1\\\" ayah=\\\"1\\\" surah=\\\"1\\\" d=\\\"M 20 18 L 200 18 L 200 42 L 20 42 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-2\\\" ayah=\\\"2\\\" surah=\\\"1\\\" d=\\\"M 20 48 L 200 48 L 200 72 L 20 72 Z\\\"/>\\n<path class=\\\"ayahPolygon\\\" fill-opacity=\\\"0\\\" id=\\\"verse-3\\\" ayah=\\\"3\\\" surah=\\\"1\\\" d=\\\"M 20 78 L 200 78 L 200 102 L 20 10