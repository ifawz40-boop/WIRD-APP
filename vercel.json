{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "*": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin-allow-popups"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://wird-quran-app.firebaseapp.com/__/auth/:path*"
    },
    {
      "source": "/__/firebase/init.json",
      "destination": "https://wird-quran-app.firebaseapp.com/__/firebase/init.json"
    },
    {
      "source": "/api/advisor/(.*)",
      "destination": "/api/advisor"
    },
    {
      "source": "/api/advisor",
      "destination": "/api/advisor"
    },
    {
      "source": "/api/tafsir/(.*)",
      "destination": "/api/tafsir"
    },
    {
      "source": "/api/tafsir",
      "destination": "/api/tafsir"
    },
    {
      "source": "/((?!api/|__/).*)",
      "destination": "/index.html"
    }
  ]
}
